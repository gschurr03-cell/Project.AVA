# Supabase — copy to .env.local and fill in. Find these in your Supabase
# project: Settings > API. For local dev use the values printed by `supabase start`.

# Public (safe to expose to the browser)
AVA_ENVIRONMENT=local
AVA_RELEASE_VERSION=development
AVA_BETA_ALLOWLIST_ENABLED=false
AVA_DIAGNOSTICS_ACCESS=disabled
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the client. Bypasses Row Level Security.
# Used by background analysis jobs that write metrics on behalf of users.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the analysis worker sends as `Authorization: Bearer <secret>`
# when POSTing results to /api/analyses/[id]/result. Server-only.
ANALYSIS_WORKER_SECRET=

# Production analysis worker (server-only; defaults shown where safe).
WORKER_ID=                         # unique per instance; hostname+pid if omitted
WORKER_VERSION=ava-worker-1.0.0
WORKER_POLL_MS=3000
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30
WORKER_PROCESSING_TIMEOUT_SECONDS=900
WORKER_MAX_FILE_BYTES=536870912
WORKER_MAX_DURATION_SECONDS=60
WORKER_MAX_SOURCE_FRAMES=14400
WORKER_TEMP_ROOT=/tmp/ava-worker
WORKER_HEALTH_PORT=8080
WORKER_LOG_LEVEL=info
MEDIAPIPE_POSE_MODEL=/app/src/lib/biomechanics/mediapipe/runtime/models/pose_landmarker_heavy.task
MEDIAPIPE_PYTHON=python3
POSE_ARTIFACTS_BUCKET=pose-artifacts

# Storage bucket holding uploaded sprint videos.
NEXT_PUBLIC_SUPABASE_VIDEO_BUCKET=sprint-videos

# Canonical web origin used for password-reset callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Versioned mobile API. Keep disabled until migration 0053 is applied and athlete
# accounts are explicitly linked through athletes.user_id.
MOBILE_API_ENABLED=false
MOBILE_MAX_UPLOAD_BYTES=536870912
MOBILE_UPLOAD_TTL_SECONDS=900
MOBILE_MINIMUM_APP_VERSION=0.1.0

# Safe client-visible flags. These never bypass metric trust.
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_30_FPS=true
NEXT_PUBLIC_FEATURE_PANNING_TIMING=false
NEXT_PUBLIC_FEATURE_RTMPOSE=false
NEXT_PUBLIC_FEATURE_MANUAL_CROSSING=true
NEXT_PUBLIC_FEATURE_SAVED_VERSIONS=true
NEXT_PUBLIC_FEATURE_EXPORTS=false
NEXT_PUBLIC_FEATURE_COMPARISON=false
NEXT_PUBLIC_FEATURE_DEVELOPER_DIAGNOSTICS=false
NEXT_PUBLIC_FEATURE_INTERPRETATION_ENGINE=true
NEXT_PUBLIC_FEATURE_INTERPRETATION_DEBUG_TRACE=false
NEXT_PUBLIC_FEATURE_PERSONAL_BASELINE_INTERPRETATIONS=false
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_INTERPRETATIONS=true
NEXT_PUBLIC_FEATURE_RECOMMENDATION_ENGINE=true
NEXT_PUBLIC_FEATURE_RECOMMENDATION_DEBUG_TRACE=false
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_RECOMMENDATIONS=true
NEXT_PUBLIC_FEATURE_ADVANCED_DRILL_RECOMMENDATIONS=false
NEXT_PUBLIC_FEATURE_PROFESSIONAL_REVIEW_RECOMMENDATIONS=false
NEXT_PUBLIC_FEATURE_PRIORITY_ENGINE=true
NEXT_PUBLIC_FEATURE_PRIORITY_DEBUG_TRACE=false
