FROM node:22-bookworm-slim AS worker

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ffmpeg libgl1 libglib2.0-0 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json requirements-mediapipe.txt ./
RUN npm ci && pip3 install --break-system-packages --no-cache-dir -r requirements-mediapipe.txt

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src/lib ./src/lib

ARG MEDIAPIPE_HEAVY_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/latest/pose_landmarker_heavy.task
ARG MEDIAPIPE_HEAVY_SHA256=64437af838a65d18e5ba7a0d39b465540069bc8aae8308de3e318aad31fcbc7b
RUN mkdir -p /app/src/lib/biomechanics/mediapipe/runtime/models \
    && curl --fail --location --retry 3 "$MEDIAPIPE_HEAVY_URL" -o /app/src/lib/biomechanics/mediapipe/runtime/models/pose_landmarker_heavy.task \
    && echo "$MEDIAPIPE_HEAVY_SHA256  /app/src/lib/biomechanics/mediapipe/runtime/models/pose_landmarker_heavy.task" | sha256sum -c -

ENV NODE_ENV=production \
    MEDIAPIPE_POSE_MODEL=/app/src/lib/biomechanics/mediapipe/runtime/models/pose_landmarker_heavy.task \
    MEDIAPIPE_PYTHON=python3 \
    WORKER_TEMP_ROOT=/tmp/ava-worker \
    WORKER_HEALTH_PORT=8080

RUN test -s "$MEDIAPIPE_POSE_MODEL" \
    && python3 -c "import cv2, mediapipe" \
    && node --check scripts/analysis-worker.mjs

RUN groupadd --system ava && useradd --system --gid ava --home-dir /app --shell /usr/sbin/nologin ava \
    && mkdir -p /tmp/ava-worker /app/.analysis-worker-build \
    && chown -R ava:ava /app /tmp/ava-worker

USER ava
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "scripts/analysis-worker.mjs"]
